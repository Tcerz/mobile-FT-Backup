+  // ---------------- Diagnosis ----------------
+
+  /// Ringkasan kondisi nyata (dibaca dari sistem Android, bukan dari memori
+  /// aplikasi) untuk mencari tahu kenapa alarm tidak berbunyi.
+  static Future<Map<String, String>> diagnosa() async {
+    await init();
+    final pending = await _plugin.pendingNotificationRequests();
+    final jadwal = pending.where((p) => p.id != _idTes).toList();
+    final terdekat = _terjadwal.values.map((v) => v.$2).where((ms) => ms > DateTime.now().millisecondsSinceEpoch).toList()..sort();
+    final zona = ZonaWaktu.aktif;
+    return {
+      'Notifikasi diizinkan': (await notifikasiDiizinkan()) ? 'Ya' : 'TIDAK',
+      'Alarm tepat waktu diizinkan': (await alarmTepatWaktuDiizinkan()) ? 'Ya' : 'TIDAK (alarm bisa telat/tidak bunyi)',
+      'Bebas pembatasan baterai': (await Permission.ignoreBatteryOptimizations.isGranted) ? 'Ya' : 'Belum (bisa dimatikan sistem)',
+      'Zona waktu aktif': zona.label,
+      'Jadwal terpasang di sistem': '${jadwal.length}',
+      'Jadwal berikutnya': terdekat.isEmpty
+          ? '-'
+          : '${zona.formatLengkap(DateTime.fromMillisecondsSinceEpoch(terdekat.first, isUtc: true))} ${zona.label}',
+      'Error penjadwalan': errorTerakhir ?? 'Tidak ada',
+    };
+  }
+
+  /// Menjadwalkan alarm UJI 1 menit dari sekarang lewat jalur yang SAMA
+  /// dengan alarm asli (zonedSchedule, bukan show). Tutup/kunci aplikasi
+  /// lalu tunggu: kalau ini tidak berbunyi, masalahnya di izin/baterai HP.
+  /// Mengembalikan pesan error, atau null kalau sukses dijadwalkan.
+  static Future<String?> ujiJadwalSatuMenit() async {
+    try {
+      await init();
+      await _buatChannel();
+      final nada = await nadaTerpilih();
+      final bolehExact = await _android?.canScheduleExactNotifications() ?? false;
+      final ms = DateTime.now().toUtc().millisecondsSinceEpoch + 60000;
+      await _plugin.zonedSchedule(
+        _idTes + 1,
+        'Tes jadwal alarm',
+        'Alarm terjadwal berhasil berbunyi tepat waktu.',
+        tz.TZDateTime.fromMillisecondsSinceEpoch(tz.UTC, ms),
+        NotificationDetails(android: _detailAlarm(nada, timeoutMs: 15000)),
+        androidScheduleMode: bolehExact ? AndroidScheduleMode.exactAllowWhileIdle : AndroidScheduleMode.inexactAllowWhileIdle,
+      );
+      return bolehExact ? null : 'Terjadwal, tapi izin "Alarm & pengingat" belum aktif -> bisa telat/tidak bunyi.';
+    } catch (e) {
+      return 'Gagal menjadwalkan: $e';
+    }
+  }
+
+  static Future<void> mintaBebasBaterai() async {
